{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://flock-urja-ops.onrender.com/docs",
      "permanent": false
    },
    {
      "source": "/docs/(.*)",
      "destination": "https://flock-urja-ops.onrender.com/docs/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://flock-urja-ops.onrender.com/api/:path*"
    },
    {
      "source": "/openapi.json",
      "destination": "https://flock-urja-ops.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
